d\": \"mx\",\n        \"name\": \"Mexico\",\n        \"exports\": {\n            \"foods\": [{\"name\": \"salsa\", \"tasty\": True, \"condiment\": True}]\n        },\n    }\n)\n\nassert db.countries.count_documents({}) == 3","key":"Pdhc1UpO0D"},{"type":"outputs","id":"xkX1NatY_GUjZC1KX5akQ","key":"m0vJW7OxWO","children":[]}],"key":"wS96uSB7UP"},{"type":"block","kind":"notebook-code","data":{"ExecuteTime":{"end_time":"2024-02-29T00:53:06.147926Z","start_time":"2024-02-29T00:53:06.141359Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"for obj in db[\"countries\"].find():\n    print_(obj)","key":"yisBekAYty"},{"type":"outputs","id":"q_MahC3wZFDtqkxL_X6-f","key":"oGbI6HLCy7","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"{'_id': 'us',\n 'exports': {'foods': [{'name': 'bacon', 'tasty': True}, {'name': 'burgers'}]},\n 'name': 'United States'}\n{'_id': 'ca',\n 'exports': {'foods': [{'name': 'bacon', 'tasty': False},\n                       {'name': 'syrup', 'tasty': True}]},\n 'name': 'Canada'}\n{'_id': 'mx',\n 'exports': {'foods': [{'condiment': True, 'name': 'salsa', 'tasty': True}]},\n 'name': 'Mexico'}\n"},"children":[]}]}],"key":"omUqYitM62"},{"type":"block","kind":"notebook-content","data":{"ExecuteTime":{"end_time":"2022-12-11T20:04:52.749811Z","start_time":"2022-12-11T20:04:52.745417Z"}},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Query","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"BefVWFQvXL"}],"identifier":"query","label":"Query","html_id":"query-1","implicit":true,"key":"jxm16EdSk6"}],"key":"PyanaRUyeJ"},{"type":"block","kind":"notebook-code","data":{"ExecuteTime":{"end_time":"2024-02-29T00:54:17.932345Z","start_time":"2024-02-29T00:54:17.919126Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"# Find the country that exports tasty bacon.\n\n# This doesn't return what we want, since we want the AND of the condition and not OR.\nprint_(\n    db.countries.find(\n        {\n            \"exports.foods.name\": \"bacon\",\n            \"exports.foods.tasty\": True,\n        },\n        {\"_id\": 0, \"name\": 1},\n    )\n)","key":"mPHOEqfA8s"},{"type":"outputs","id":"4QZf93-kj4xaDKYtODQaA","key":"TVnfBjEsiP","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"[{'name': 'United States'}, {'name': 'Canada'}]\n"},"children":[]}]}],"key":"wxh6gwGeEU"},{"type":"block","kind":"notebook-code","data":{"ExecuteTime":{"end_time":"2024-02-29T00:54:41.837773Z","start_time":"2024-02-29T00:54:41.830767Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"# Using $elemMatch.\nprint_(\n    db.countries.find(\n        {\n            \"exports.foods\": {\n                \"$elemMatch\": {\n                    \"name\": \"bacon\",\n                    \"tasty\": True,\n                }\n            }\n        },\n        {\"_id\": 0, \"name\": 1},\n    )\n)","key":"yhbxEstzER"},{"type":"outputs","id":"laLRNwxznmh0KE27HMNbE","key":"JlD2GA5Lj6","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"[{'name': 'United States'}]\n"},"children":[]}]}],"key":"M31CRHYZeI"},{"type":"block","kind":"notebook-code","data":{"ExecuteTime":{"end_time":"2024-02-28T21:51:46.782973Z","start_time":"2024-02-28T21:51:46.778314Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"# This performs an AND.\nprint_(db.countries.find({\"_id\": \"mx\", \"name\": \"United States\"}))\n\n# This performs an OR.\nprint_(\n    db.countries.find(\n        {\"$or\": [{\"_id\": \"mx\"}, {\"name\": \"United States\"}]}, {\"_id\": 1}\n    )\n)","key":"mf9PoXWSAD"},{"type":"outputs","id":"gI6JLBgwGLUFPy_6vrEEc","key":"RKPSwtzwFc","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"[]\n[{'_id': 'us'}, {