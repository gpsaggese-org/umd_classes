o-db","implicit":true,"key":"LmR96p4OXU"}],"key":"OGVRZUT1en"},{"type":"block","kind":"notebook-code","data":{"ExecuteTime":{"end_time":"2024-02-29T00:44:20.515925Z","start_time":"2024-02-29T00:44:20.500202Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"import pymongo\n\n\ndef print_(cursor, mode=\"pprint\", tag=\"\"):\n    \"\"\"\n    Print collection.\n    \"\"\"\n    if tag:\n        print(\"%s=\" % tag)\n    if isinstance(cursor, pymongo.cursor.Cursor):\n        # Serialize a cursor into a list.\n        obj = list(cursor)\n    else:\n        obj = cursor\n    if mode in (\"json\", \"json_color\"):\n        import json\n\n        parsed = json.loads(json.dumps(obj))\n        if mode == \"json\":\n            print(json.dumps(parsed, indent=2))\n        else:\n            import rich\n\n            rich.print_json(json.dumps(parsed, indent=2))\n    elif mode == \"pprint\":\n        pprint.pprint(obj)\n    else:\n        raise ValueError(f\"Invalid mode='{mode}'\")\n\n\nfrom bson.objectid import ObjectId\n\n# Connect to MongoDB instance.\nclient = pymongo.MongoClient(\"localhost\", 27017)\n\n# Create a Mongo database.\ndb = client[\"book\"]\nprint(\"db=\", db)\nprint(\"type(db)=\", type(db))","key":"wdRBrjjTjr"},{"type":"outputs","id":"mRRSj_-iSG7fPV5jQUY7N","key":"oJq9PmDIt6","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"db= Database(MongoClient(host=['localhost:27017'], document_class=dict, tz_aware=False, connect=True), 'book')\ntype(db)= <class 'pymongo.synchronous.database.Database'>\n"},"children":[]}]}],"key":"EgaFWs5JSg"},{"type":"block","kind":"notebook-code","data":{"ExecuteTime":{"end_time":"2024-02-29T00:45:15.590397Z","start_time":"2024-02-29T00:45:15.574760Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"# Show all the collections in the DB.\nprint(\"collections=\", db.list_collection_names())\n\n# Clean all the collections.\nfor collection_name in db.list_collection_names():\n    print(\"Dropping collection %s\" % collection_name)\n    db[collection_name].drop()\n\n# Show all the collections in the DB.\nprint(\"collections=\", db.list_collection_names())","key":"VpGVk9U5Q7"},{"type":"outputs","id":"xTdy3JHVEtCvY_pWktGlE","key":"yrDecFAHSS","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"collections= ['towns2']\nDropping collection towns2\ncollections= []\n"},"children":[]}]}],"key":"XduO48gLaH"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":1,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"inlineCode","value":"Towns","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"SospRqYG0g"},{"type":"text","value":" collection","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"BiaPifN5tK"}],"identifier":"towns-collection","label":"Towns collection","html_id":"towns-collection","implicit":true,"key":"CnwcZc9IeS"}],"key":"PCfddOYQSE"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Insert","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"IqMtwwhxc0"}],"identifier":"insert","label":"Insert","html_id":"insert","implicit":true,"key":"pXQDVyJCu9"}],"key":"hgMkP3oW5d"},{"type":"block","kind":"notebook-code","data":{"ExecuteTime":{"end_time":"2024-02-29T00:45:45.458892Z","start_time":"2024-02-29T00:45:45.426844Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"dict_ = {\n    \"name\": \"New York\",\n    \"population\": 22200000,\n    \"lastCensus\": \"2022-11-01\",\n    \"famousFor\": [\"the MOMA\", \"food\", \"Derek Jeter\"],\n    \"mayor\": {\"name\": \"Bill de Blasio\", \"party\": \"D\"},\n}\nprint_(dict_, tag=\"dict_\")\n\n# Inserting an object in a DB creates a DB