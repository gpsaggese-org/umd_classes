agraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Behavior of SQL for aggregates is somewhat complicated. Generally speaking NULLs are ignored during aggregation, but there are exceptions. Below we run some natural queries on the above table.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"jM5eGbxX5X"}],"key":"YfOMHuUEgL"}],"key":"GAAsMhXvWx"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"%sql select count(*) from R;","key":"kaEe0UKKRy"},{"type":"outputs","id":"IMbkmpNJH2N0HPl4lXkiT","key":"giKaXvt42q","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":" * postgresql://postgres:***@localhost/university\n1 rows affected.\n"},"children":[]},{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":12,"metadata":{},"data":{"text/html":{"content":"<table>\n    <thead>\n        <tr>\n            <th>count</th>\n        </tr>\n    </thead>\n    <tbody>\n        <tr>\n            <td>6</td>\n        </tr>\n    </tbody>\n</table>","content_type":"text/html"},"text/plain":{"content":"[(6,)]","content_type":"text/plain"}}},"children":[]}]}],"key":"kzGf9EeluM"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"## count(*) counts everything. Whereas count(i) will ignore NULLs.\n%sql select count(i) from R;","key":"oQCx5fkWK7"},{"type":"outputs","id":"Ma9wNSLLAoM9gfOAgnNkg","key":"gARvTh1GIO","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":" * postgresql://postgres:***@localhost/university\n1 rows affected.\n"},"children":[]},{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":13,"metadata":{},"data":{"text/html":{"content":"<table>\n    <thead>\n        <tr>\n            <th>count</th>\n        </tr>\n    </thead>\n    <tbody>\n        <tr>\n            <td>4</td>\n        </tr>\n    </tbody>\n</table>","content_type":"text/html"},"text/plain":{"content":"[(4,)]","content_type":"text/plain"}}},"children":[]}]}],"key":"DVwayz8Qle"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"## The below shows that even if a row contains only NULLs, it is still counted in count(*).\n%sql drop table if exists S;\n%sql create table S (i int, j int);\n%sql insert into S values (null, null), (10, null);\n%sql select count(*) from S;","key":"D3bQWHT6MW"},{"type":"outputs","id":"0fhy8-Ccz05D5cIComaz2","key":"eHEK9rj8QU","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":" * postgresql://postgres:***@localhost/university\nDone.\n * postgresql://postgres:***@localhost/university\nDone.\n * postgresql://postgres:***@localhost/university\n2 rows affected.\n * postgresql://postgres:***@localhost/university\n1 rows affected.\n"},"children":[]},{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":14,"metadata":{},"data":{"text/html":{"content":"<table>\n    <thead>\n        <tr>\n            <th>count</th>\n        </tr>\n    </thead>\n    <tbody>\n        <tr>\n            <td>2</td>\n        </tr>\n    </tbody>\n</table>","content_type":"text/html"},"text/plain":{"content":"[(2,)]","content_type":"text/plain"}}},"children":[]}]}],"key":"KkGUd4aBdW"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"## sum() will also ignore NULLs and just sum up the values that are not null;\n%sql select sum(i) from R;","key":"N8lMaFeFBS"},{"type":"outputs","id":"w5muscMoYXl_AUVHId_Mm","key":"eez2b595eM","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":" * postgresql://postgres:***@localhost/university\n1 rows affected.\n"},"children":[]},{"type":"output","jupyter_data":{"output_type":"execute_result","ex