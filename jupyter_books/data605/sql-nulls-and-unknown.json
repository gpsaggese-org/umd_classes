{"version":3,"kind":"Notebook","sha256":"21919b1fa286992ae67659c00f9ff173e4e9b32c2c2ac00cec500b37e8565893","slug":"sql-nulls-and-unknown","location":"/../tutorials/tutorial_postgres/tutorial_university/sql_nulls_and_unknown.ipynb","dependencies":[],"frontmatter":{"title":"Aggregates","content_includes_title":true,"kernelspec":{"name":"python3","display_name":"Python 3 (ipykernel)","language":"python"},"jupytext":{"formats":"ipynb,py:percent"},"numbering":{"title":{"offset":2}},"exports":[{"format":"ipynb","filename":"sql_nulls_and_unknown.ipynb","url":"/jupyter_books/data605/build/sql_nulls_and_unknow-53b734250c23e558a634f7bd7208df2a.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"This notebook covers how NULLs are handled and the results of different types of queries in presence of NULLs. Recall that NULL is a special value used when we don’t know the value of an attribute, which may be because the value is missing, it is inapplicable, or it is hidden. It is usually a bad idea to assign any specific meaning to the NULL value, but you should know how the query answers are affected.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"RFeI7eUFya"}],"key":"h2Au2gJFNx"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"strong","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"NOTE:","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"qmRZaJEUic"}],"key":"R0HIlm9DsX"},{"type":"text","value":" NULLs are displayed as “None” by Jupyter, whereas ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"jEIpfFn81g"},{"type":"inlineCode","value":"psql","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"NNe6z1npTP"},{"type":"text","value":" just shows an empty space.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"mJiiFDWvxv"}],"key":"dBcZC0nBvr"}],"key":"qTdLnrqeXt"},{"type":"block","kind":"notebook-code","data":{"ExecuteTime":{"end_time":"2024-02-15T01:05:07.860336Z","start_time":"2024-02-15T01:05:07.809126Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"%load_ext sql\n%sql postgresql://postgres:postgres@localhost/university\n%config SqlMagic.style = '_DEPRECATED_DEFAULT'","key":"AxgJE2dF3O"},{"type":"outputs","id":"cZHw_XMyMEyKrAY7ymp1y","key":"FDoEahCOfm","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"The sql extension is already loaded. To reload it, use:\n  %reload_ext sql\n"},"children":[]}]}],"key":"EkgF36wsqV"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"## Let's create a simple table, with a few NULL values in it\n%sql drop table if exists R;\n%sql create table R (i int, j int);\n%sql insert into R values(10, 10), (10, 20), (10, null), (null, 20), (null, 30), (20, null);\n%sql select * from R;","key":"CvJT1XezbB"},{"type":"outputs","id":"nwLCMzbZboHBu5EINsWxj","key":"lxR5ezAzWF","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":" * postgresql://postgres:***@localhost/university\nDone.\n * postgresql://postgres:***@localhost/university\nDone.\n * postgresql://postgres:***@localhost/university\n6 rows affected.\n * postgresql://postgres:***@localhost/university\n6 rows affected.\n"},"children":[]},{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":5,"metadata":{},"data":{"text/html":{"content":"<table>\n    <thead>\n        <tr>\n            <th>i</th>\n            <th>j</th>\n        </tr>\n    </thead>\n    <tbody>\n        <tr>\n            <td>10</td>\n            <td>10</td>\n        </tr>\n        <tr>\n            <td>10</td>\n            <td>20</td>\n        </tr>\n        <tr>\n            <td>10</td>\n            <td>None</td>\n        </tr>\n        <tr>\n            <td>None</td>\n            <td>20</td>\n        </tr>\n        <tr>\n            <td>None</td>\n            <td>30</td>\n        </tr>\n        <tr>\n            <td>20</td>\n            <td>None</td>\n        </tr>\n    </tbody>\n</table>","content_type":"text/html"},"text/plain":{"content":"[(10, 10), (10, 20), (10, None), (None, 20), (None, 30), (20, None)]","content_type":"text/plain"}}},"children":[]}]}],"key":"Ep6qBOgXCB"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Result of any arithmetic or similar operation involving NULL is NULL. So: 10 + NULL = NULL, 10 * NULL = NULL, and so on.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"RmhNK133Ox"}],"key":"Jnys4Wwh6o"}],"key":"HxuhDcByd8"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"%sql select i * 10 from R;","key":"O9spmwlG36"},{"type":"outputs","id":"a6hzlma3HUgFfHSUStdG8","key":"qLF6EIxPTy","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":" * postgresql://postgres:***@localhost/university\n6 rows affected.\n"},"children":[]},{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":6,"metadata":{},"data":{"text/html":{"content":"<table>\n    <thead>\n        <tr>\n            <th>?column?</th>\n        </tr>\n    </thead>\n    <tbody>\n        <tr>\n            <td>100</td>\n        </tr>\n        <tr>\n            <td>100</td>\n        </tr>\n        <tr>\n            <td>100</td>\n        </tr>\n        <tr>\n            <td>None</td>\n        </tr>\n        <tr>\n            <td>None</td>\n        </tr>\n        <tr>\n            <td>200</td>\n        </tr>\n    </tbody>\n</table>","content_type":"text/html"},"text/plain":{"content":"[(100,), (100,), (100,), (None,), (None,), (200,)]","content_type":"text/plain"}}},"children":[]}]}],"key":"DjbHUVRVPx"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"On the other hand, the result of a boolean operation involving a NULL is an ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"jmrDaROkTk"},{"type":"strong","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"UNKNOWN","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"mRXQVpgFJb"}],"key":"ilQF1MZfbh"},{"type":"text","value":", which is another special value used by SQL. So the result of: NULL = 10 is an UNKNOWN.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"H64zIlplbV"}],"key":"wuiKPZJ77m"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Consider a joint predicate: (NULL = 10) or (10 = 10). The first part evaluates to an UNKNOWN, whereas the second part evaluates to a TRUE. In this case, the joint predicate evaluates to a TRUE -- because whichever value UNKNOWN might take (TRUE or FALSE), the result of the joint predicate will always be TRUE.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"exR7x8y3Yp"}],"key":"Md4CwXmfUt"}],"key":"Oxb9uZcBag"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Similarly: UNKNOWN OR FALSE = UNKNOWN, because the result depends on what is the actual value of the first part.\nUNKNOWN and TRUE = UNKNOWN.\nUNKNOWN and FALSE = FALSE.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"mXPDSuNhUe"}],"key":"dJigPatBwA"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"You can try out similar queries as above to see this. Note that: Jupyter also prints out an UNKNOWN as a None.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"r1ZiVY1cGi"}],"key":"Oqqnlk5wNh"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"UNKNOWNs are carried through the evaluation as long as possible, but are finally evaluated to False when it is time to output the results.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"jH5TYpAweh"}],"key":"JvU2VcnTtE"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"The first query below shows the results of applying a predicate “j = 10” to R. The second query does the actual selection and as you can see, only the tuples that satisfy are returned.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"JYdkG7SmGf"}],"key":"ZXu4S2FnfG"}],"key":"v7dpfoanBn"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"%sql select *, j = 10 from R;","key":"x1ZWUvlXOx"},{"type":"outputs","id":"kmzABsP9hndbn0RXMVQ2d","key":"rmTxr8Yw8a","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":" * postgresql://postgres:***@localhost/university\n6 rows affected.\n"},"children":[]},{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":7,"metadata":{},"data":{"text/html":{"content":"<table>\n    <thead>\n        <tr>\n            <th>i</th>\n            <th>j</th>\n            <th>?column?</th>\n        </tr>\n    </thead>\n    <tbody>\n        <tr>\n            <td>10</td>\n      