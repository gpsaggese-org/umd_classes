01b[43mmpl\u001b[49m\u001b[38;5;241;43m.\u001b[39;49m\u001b[43mimage\u001b[49m\u001b[38;5;241;43m.\u001b[39;49m\u001b[43mimsave\u001b[49m\u001b[43m(\u001b[49m\n\u001b[1;32m    431\u001b[0m \u001b[43m    \u001b[49m\u001b[43mfilename_or_obj\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[38;5;28;43mself\u001b[39;49m\u001b[38;5;241;43m.\u001b[39;49m\u001b[43mbuffer_rgba\u001b[49m\u001b[43m(\u001b[49m\u001b[43m)\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[38;5;28;43mformat\u001b[39;49m\u001b[38;5;241;43m=\u001b[39;49m\u001b[43mfmt\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43morigin\u001b[49m\u001b[38;5;241;43m=\u001b[39;49m\u001b[38;5;124;43m\"\u001b[39;49m\u001b[38;5;124;43mupper\u001b[39;49m\u001b[38;5;124;43m\"\u001b[39;49m\u001b[43m,\u001b[49m\n\u001b[1;32m    432\u001b[0m \u001b[43m    \u001b[49m\u001b[43mdpi\u001b[49m\u001b[38;5;241;43m=\u001b[39;49m\u001b[38;5;28;43mself\u001b[39;49m\u001b[38;5;241;43m.\u001b[39;49m\u001b[43mfigure\u001b[49m\u001b[38;5;241;43m.\u001b[39;49m\u001b[43mdpi\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43mmetadata\u001b[49m\u001b[38;5;241;43m=\u001b[39;49m\u001b[43mmetadata\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43mpil_kwargs\u001b[49m\u001b[38;5;241;43m=\u001b[39;49m\u001b[43mpil_kwargs\u001b[49m\u001b[43m)\u001b[49m\n\nFile \u001b[0;32m/venv/lib/python3.12/site-packages/matplotlib/image.py:1657\u001b[0m, in \u001b[0;36mimsave\u001b[0;34m(fname, arr, vmin, vmax, cmap, format, origin, dpi, metadata, pil_kwargs)\u001b[0m\n\u001b[1;32m   1655\u001b[0m pil_kwargs\u001b[38;5;241m.\u001b[39msetdefault(\u001b[38;5;124m\"\u001b[39m\u001b[38;5;124mformat\u001b[39m\u001b[38;5;124m\"\u001b[39m, \u001b[38;5;28mformat\u001b[39m)\n\u001b[1;32m   1656\u001b[0m pil_kwargs\u001b[38;5;241m.\u001b[39msetdefault(\u001b[38;5;124m\"\u001b[39m\u001b[38;5;124mdpi\u001b[39m\u001b[38;5;124m\"\u001b[39m, (dpi, dpi))\n\u001b[0;32m-> 1657\u001b[0m \u001b[43mimage\u001b[49m\u001b[38;5;241;43m.\u001b[39;49m\u001b[43msave\u001b[49m\u001b[43m(\u001b[49m\u001b[43mfname\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[38;5;241;43m*\u001b[39;49m\u001b[38;5;241;43m*\u001b[39;49m\u001b[43mpil_kwargs\u001b[49m\u001b[43m)\u001b[49m\n\nFile \u001b[0;32m/venv/lib/python3.12/site-packages/PIL/Image.py:2576\u001b[0m, in \u001b[0;36mImage.save\u001b[0;34m(self, fp, format, **params)\u001b[0m\n\u001b[1;32m   2574\u001b[0m         fp \u001b[38;5;241m=\u001b[39m builtins\u001b[38;5;241m.\u001b[39mopen(filename, \u001b[38;5;124m\"\u001b[39m\u001b[38;5;124mr+b\u001b[39m\u001b[38;5;124m\"\u001b[39m)\n\u001b[1;32m   2575\u001b[0m     \u001b[38;5;28;01melse\u001b[39;00m:\n\u001b[0;32m-> 2576\u001b[0m         fp \u001b[38;5;241m=\u001b[39m \u001b[43mbuiltins\u001b[49m\u001b[38;5;241;43m.\u001b[39;49m\u001b[43mopen\u001b[49m\u001b[43m(\u001b[49m\u001b[43mfilename\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[38;5;124;43m\"\u001b[39;49m\u001b[38;5;124;43mw+b\u001b[39;49m\u001b[38;5;124;43m\"\u001b[39;49m\u001b[43m)\u001b[49m\n\u001b[1;32m   2577\u001b[0m \u001b[38;5;28;01melse\u001b[39;00m:\n\u001b[1;32m   2578\u001b[0m     fp \u001b[38;5;241m=\u001b[39m cast(IO[\u001b[38;5;28mbytes\u001b[39m], fp)\n\n\u001b[0;31mFileNotFoundError\u001b[0m: [Errno 2] No such file or directory: '/app/lectures_source/figures/Lesson07.Comparing_models.data.png'"},"children":[]},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"05417d7726b031ff08975782ed33c836","path":"/jupyter_books/msml610/build/05417d7726b031ff08975782ed33c836.png"},"text/plain":{"content":"<Figure size 800x300 with 1 Axes>","content_type":"text/plain"}}},"children":[]}]}],"key":"T74D8LVtfS"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Linear model.\nwith pm.Model() as model_l:\n    # mu = alpha + beta * x\n    alpha = pm.Normal(\"alpha\", mu=0, sigma=1)\n    beta = pm.Normal(\"beta\", mu=0, sigma=10)\n    mu = alpha + beta * x_c[0]\n    #\n    sigma = pm.HalfNormal(\"sigma\", 5)\n    #\n    y_pred = pm.Normal(\"y_pred\", mu=mu, sigma=sigma, observed=y_c)\n    #\n    idata_l = pm.sample(2000, idata_kwargs={\"log_likelihood\": True})\n    idata_l.extend(pm.sample_posterior_predictive(idata_l))\n\n\n# Quadratic model.\nwith pm.Model() as model_p:\n    # mu = alpha + beta_1 * x + beta_2 * x^2\n    alpha = pm.Normal(\"alpha\", mu=0, sigma=1)\n    # Beta is a 2-dim vector.\n    beta = pm.Normal(\"beta\", mu=0, sigma=10, shape=order)\n    mu = alpha + pm.math.dot(beta, x_c)\n    #\n    sigma = pm.HalfNormal(\"sigma\", 5)\n    #\n    y_pred = pm.Normal(\"y_pred\", mu=mu, sigma=sigma, observed=y_c)\n    #\n    idata_q = pm.sample(2000, idata_kwargs={\"log_likelihood\": True})\n    idata_q.extend(pm.sample_posterior_predictive(idata_q))","key":"MpPHOmb76a"},{"type":"outputs","id":"dxBQI8kKffsy4Csj6r5If","key":"ULpg9AhzGJ","children":[]}],"key":"idcNTJZhp0"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"#\n# Plot the data and the fit linear and quadratic models (using the mean posterior).\n#\n\n# Sample the x space uniformly with 100 samples.\nx_new = np.linspace(x_c[0].min(), x_c[0].max(), 100)\n\n# Posterior.\nposterior_l = az.extract(idata_l)\nposterior_p = az.extract(idata_q)\n# print(posterior_l)\n\n# Compute the mean posterior of the linear model.\nalpha_l_post = posterior_l[\"alpha\"].mean().item()\nbeta_l_post = posterior_l[\"beta\"].mean().item()\nprint(\n    f\"linear model: alpha_l_post={alpha_l_post:.2g}, beta_l_post={beta_l_post:.2g}\"\n)\ny_l_post = alpha_l_post + beta_l_post * x_new\n\n# Plot the mean posterior of the linear model.\nplt.plot(x_new, y_l_post, \"C0\", label=\"linear model\")\n\n# Quadratic model.\nalpha_p_post = posterior_p[\"alpha\"].mean().item()\nbeta_p_post = posterior_p[\"beta\"].mean(\"sample\")\nprint(\n    f\"quadratic model: alpha_p_post={alpha_p_post:.2g}, beta_post[0]={beta_p_post[0]:.2g}, beta_post[1]={beta_p_post[1]:.2g}\"\n)\ny_p_post = alpha_p_post + np.dot(beta_p_post, x_c)\n\n# idx = np.argsort(x_c[0])\n# plt.plot(x_c[0][idx], y_p_post[idx], \"C1\", label=\"quadratic model\")\nplt.plot(x_c[0], y_p_post, \"C1\", label=\"quadratic model\")\n\n# Plot data.\nplt.plot(x_c[0], y_c, \"C2.\")\n\nut.save_plt(\"Lesson07.Comparing_models.model_fit.png\")","key":"N0KGjC4C0a"},{"type":"outputs","id":"PpcIGfg04WpHVw35nUG0u","key":"JL9A8PLzux","children":[]}],"key":"UAJrLz3iwQ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"#\n# Plot the posterior predictive check for both models.\n#\n\naz.plot_ppc(idata_l, num_pp_samples=100, colors=[\"C1\", \"C0\", \"C1\"])\nplt.title(\"linear model\")\nut.save_plt(\"Lesson07.Comparing_models.lin_model_PPC.png\")\n\naz.plot_ppc(idata_q, num_pp_samples=100, colors=[\"C1\", \"C0\", \"C1\"])\nplt.title(\"quadratic model\")\nut.save_plt(\"Lesson07.Comparing_models.quadr_model_PPC.png\")","key":"d8WLIz5QFZ"},{"type":"outputs","id":"HUBmiGyZCNGiwoxOnQf1e","key":"JcfacUdRR6","children":[]}],"key":"qJaLCEKNf7"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# ?az.plot_bpv","key":"emfq0EzJiM"},{"type":"outputs","id":"xizUVGcpMT4lt_DI4fmYD","key":"uWyxOtKOuF","children":[]}],"key":"E1p3QYWwKM"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Bayesian p-value","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"VtPXKwsiKl"}],"identifier":"bayesian-p-value","label":"Bayesian p-value","html_id":"bayesian-p-value","implicit":true,"key":"bdlCTrz9ua"}],"key":"AFpA9RSxJd"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"#\n# Compare the Bayesian p-value for a statistic for linear and quadratic model.\n#\n\ncolors = [\"C0\", \"C1\"]\nidatas = [idata_l, idata_q]\n\nfig, axes = plt.subplots(2, 1)\n\n# Plot the Bayesian p-value for mean for both models.\nfor idata, c in zip(idatas, colors):\n    # Plot Bayesian p-value.\n    az.plot_bpv(idata, kind=\"t_stat\", t_stat=\"mean\", ax=axes[0], color=c)\n    axes[0].set_title(\"linear\")\n\n\n# Plot the Bayesian p-value for interquartile range for both models.\ndef iqr(x, a=-1):\n    \"\"\"\n    Interquartile range.\n    \"\"\"\n    return np.subtract(*np.percentile(x, [75, 25], axis=a))\n\n\nfor idata, c in zip(idatas, colors):\n    # Plot Bayesian p-value.\n    az.plot_bpv(idata, kind=\"t_stat\", t_stat=iqr, ax=axes[1], color=c)","key":"mMJRrYNJaA"},{"type":"outputs","id":"zVkna86rn_r5-rVa00i56","key":"Mmc59PI0bF","children":[]}],"key":"DtM4Z2h2Ba"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"#\n# Compare Bayesian p-value for entire distribution.\n#\n\nfig, ax = plt.subplots()\n\nfor idata, c in zip(idatas, colors):\n    az.plot_bpv(idata, color=c, ax=ax)","key":"rFm093jLSY"},{"type":"outputs","id":"eUgIOZReAf2E55_lavQax","key":"aO6r4Fh4je","children":[]}],"key":"MihADMB7Zx"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Overfitting","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"wq04X3dMv9"}],"identifier":"overfitting","label":"Overfitting","html_id":"overfitting","implicit":true,"key":"G1IbdmMs1Y"}],"key":"Zh3GVGp5Ev"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"_, ax = plt.subplots(1, 1)\n\nx0 = np.array([4.0, 5.0, 6.0, 9.0, 12, 14.0])\ny0 = np.array([4.2, 6.1, 5.0, 10.0, 10, 14.0])\nx1 = np.array([6.5, 10])\ny1 = np.array([7, 10])\n\nax.plot(x0, y0, \"ko\")\nax.plot(x1, y1, \"rs\")","key":"BLTlMyCmGA"},{"type":"outputs","id":"Qk7LEOUPMyU2IKzFA6R9d","key":"EhLZKzXvKp","children":[]}],"key":"dk90Lw28aM"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"#\n# Fit model on in-sample data.\n#\n_, ax = plt.subplots(1, 1)\n\n# Data.\nx0 = np.array([4.0, 5.0, 6.0, 9.0, 12, 14.0])\ny0 = np.array([4.2, 6.1, 5.0, 10.0, 10, 14.0])\nax.plot(x0, y0, \"ko\", zorder=3)\n\n# Learn 3 models.\norder = [0, 1, 5]\nx_n = np.linspace(x0.min(), x0.max(), 100)\nps = []\nfor i in order:\n    # Learn the models.\n    p = np.polynomial.Polynomial.fit(x0, y0, deg=i)\n    ps.append(p)\n\n\n#\ndef plot_models(x0, y0, ps):\n    for i in range(len(order)):\n        p = ps[i]\n        # Evaluate on the raw data.\n        yhat = p(x0)\n        # Estimate the error between the estimates and the true values.\n        ss_regression = np.sum((yhat - y0) ** 2)\n        # Compute R^2.\n        ybar = np.mean(y0)\n        ss_total = np.sum((ybar - y0) ** 2)\n        r2 = 1 - ss_regression / ss_total\n        #\n        ax.plot(x_n, p(x_n), label=f\"order {i}, $R^2$= {r2:.3f}\", lw=3)\n    ax.legend(loc=2)\n\n\nplot_models(x0, y0, ps)","key":"RN5gQaZc5x"},{"type":"outputs","id":"qKzsAKNLfRr65mfdsm2q9","key":"rxmGVSd7BH","children":[]}],"key":"LRvtBG2UXB"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"#\n# Evaluate the fit model on the out-of-sample data.\n#\n_, ax = plt.subplots(figsize=(12, 4))\nx_ = np.array([6.5, 10])\ny_ = np.array([7, 10])\n\nax.plot(x0, y0, \"ko\", zorder=3)\nax.plot(x_, y_, \"rs\", zorder=3)\n\nx1 = np.concatenate((x0, x_))\ny1 = np.concatenate((y0, y_))\n\nplot_models(x1, y1, ps)","key":"E9MPhJQ5UH"},{"type":"outputs","id":"oaNgPKXLRRj877ckQ8cWr","key":"RgtkNlEqkM","children":[]}],"key":"AGns4nKDgX"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Calculating predictive accuracy","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ZsIrrcS1tJ"}],"identifier":"calculating-predictive-accuracy","label":"Calculating predictive accuracy","html_id":"calculating-predictive-accuracy","implicit":true,"key":"fdG851hKNy"}],"key":"OGQJljUW3q"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"waic_l = az.waic(idata_l)\nwaic_l","key":"hDMGNytb9h"},{"type":"outputs","id":"41MmQOnVRhGkqS-Cerrhb","key":"v32tKzufOO","children":[]}],"key":"qgv86DuHIj"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"waic_q = az.waic(idata_q)\nwaic_q","key":"VmNv0g0BTG"},{"type":"outputs","id":"jJXvEwGENOoi563C6AC55","key":"UG6ytyt9xu","children":[]}],"key":"LVDXlnh5MV"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"loo_l = az.loo(idata_l)\nloo_l","key":"k8luUglSgh"},{"type":"outputs","id":"Q3_8rbRtzmX6qQjJ5RPCF","key":"TDLvAlFOfC","children":[]}],"key":"cKjrewb9y4"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"loo_q = az.loo(idata_q)\nloo_q","key":"oNQjabHOXY"},{"type":"outputs","id":"LD17VR9FdCgyJVvrgrIo3","key":"t3jnaFQ6lR","children":[]}],"key":"F3SieJ8x5l"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Comparing models","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"vLcuySfTcv"}],"identifier":"comparing-models","label":"Comparing models","html_id":"comparing-models","implicit":true,"key":"ffY4U5VkVz"}],"key":"kTCtndXiil"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"cmp_df = az.compare({\"model_l\": idata_l, \"model_q\": idata_q})\ndisplay(cmp_df)","key":"JjjcF1ZNCs"},{"type":"outputs","id":"NhcrQ2o0At8YGkOhRznXZ","key":"hj2KbFHi1P","children":[]}],"key":"nMNZsqwFpa"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"az.plot_compare(cmp_df)","key":"MBlK95vuLp"},{"type":"outputs","id":"3hCkHNwX2OAGHVhGc-R53","key":"JveD9tUpBN","children":[]}],"key":"QElrYUfyZ2"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Model averaging","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"MQLfaRjPmn"}],"identifier":"model-averaging","label":"Model averaging","html_id":"model-averaging","implicit":true,"key":"IAaVuseooF"}],"key":"bh2bhUQvlI"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"idatas = [idata_l, idata_q]\nweights = [0.35, 0.65]\nidata_w = az.weight_predictions(idatas, weights)","key":"r7EPhev69J"},{"type":"outputs","id":"WRO19WGIgAe95ZAB4wm9j","key":"rU9d4bZyiy","children":[]}],"key":"Rd2zjH0F8B"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Plot the KDE of the posterior predictive.\n_, ax = plt.subplots(figsize=(10, 6))\n\n# Linear.\naz.plot_kde(\n    idata_l.posterior_predictive[\"y_pred\"].values,\n    plot_kwargs={\"color\": \"C0\", \"lw\": 3},\n    label=\"linear\",\n    ax=ax,\n)\n\n# Quadratic.\naz.plot_kde(\n    idata_q.posterior_predictive[\"y_pred\"].values,\n    plot_kwargs={\"color\": \"C1\", \"lw\": 3},\n    label=\"quadratic\",\n    ax=ax,\n)\n\n# Weighted.\naz.plot_kde(\n    idata_w.posterior_predictive[\"y_pred\"].values,\n    plot_kwargs={\"color\": \"C2\", \"lw\": 3, \"ls\": \"--\"},\n    label=\"weighted\",\n    ax=ax,\n)\n\nplt.legend()","key":"BPOmgTfFgD"},{"type":"outputs","id":"Vm4V4--wNAczibfjf_IrH","key":"Knugf3H2H7","children":[]}],"key":"Q12ww2dZAe"}],"key":"zFKQLhMDDm"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Generalized Linear Models","url":"/l07-04-generalized-linear-models","group":"L07 - Probabilistic Programming"},"next":{"title":"Causal Inference","url":"/l08-04-01-causal-inference","group":"L08 - Causal Inference"}}},"domain":"http://localhost:3000"}