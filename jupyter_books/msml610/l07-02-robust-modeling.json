"display_data","metadata":{},"data":{"application/vnd.jupyter.widget-view+json":{"content":"{\"model_id\":\"15e3df9c69404f4e903fd0583186a51d\",\"version_major\":2,\"version_minor\":0}","content_type":"application/vnd.jupyter.widget-view+json"},"text/plain":{"content":"Output()","content_type":"text/plain"}}},"children":[]},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/html":{"content":"<pre style=\"white-space:pre;overflow-x:auto;line-height:normal;font-family:Menlo,'DejaVu Sans Mono',consolas,'Courier New',monospace\"></pre>\n","content_type":"text/html"},"text/plain":{"content":"","content_type":"text/plain"}}},"children":[]}]}],"key":"oXKWdioNR2"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Black: KDE of the data (observed)\n# Blue: KDEs of the posterior predictive samples\n# Orange: KDE of the posterior predictive mean\naz.plot_ppc(y_pred_g, mean=True, num_pp_samples=100)","key":"qwwL0WMZpc"},{"type":"outputs","id":"48AqA-i8mULgAjul4wwge","key":"vYHwGCTszn","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"da473089bc82b12bbdcaab41cb826746","path":"/jupyter_books/msml610/build/da473089bc82b12bbdcaab41cb826746.png"},"text/plain":{"content":"<Figure size 800x300 with 1 Axes>","content_type":"text/plain"}}},"children":[]}]}],"key":"L9iP3L6C0S"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Student-t","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"tRxe6i7bOC"}],"identifier":"student-t","label":"Student-t","html_id":"student-t","implicit":true,"key":"qbTbTb2SX5"}],"key":"bFXQZNNEJc"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Show the PDF for various values of \\nu.\n\n# Points to be used to sample the PDF.\nx_values = np.linspace(-10, 10, 500)\n\n# Plot t-student sweeping \\nu.\nfor df in [0.1, 0.5, 1, 2, 5, 10, 30]:\n    # Student-t with df.\n    distr = stats.t(df)\n    # Compute PDF.\n    x_pdf = distr.pdf(x_values)\n    plt.plot(x_values, x_pdf, label=f\"nu={df}\")\n\n# Plot gaussian.\nx_pdf = stats.norm.pdf(x_values)\nplt.plot(x_values, x_pdf, \"k--\", label=\"Gauss / nu=infty\")\n\nplt.xlim(-5, 5)\nplt.legend()\n\ntitle = \"Chap7: Student-t\"\nut.process_figure(title)","key":"B6hbdqDm04"},{"type":"outputs","id":"yZjn56dxH-xSxgwSTYCXV","key":"ARwOJfZZ4B","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"03b22d07d8dfc85fd4b11b9d89bc3410","path":"/jupyter_books/msml610/build/03b22d07d8dfc85fd4b11b9d89bc3410.png"},"text/plain":{"content":"<Figure size 800x300 with 1 Axes>","content_type":"text/plain"}}},"children":[]}]}],"key":"ubPXBldn9a"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Use a Student-T model.\nwith pm.Model() as model_t:\n    mu = pm.Uniform(\"mu\", 40, 75)\n    sigma = pm.HalfNormal(\"sigma\", sigma=10)\n    # A student with nu = 30 is close to a Gaussian.\n    nu = pm.Exponential(\"nu\", 1 / 30)\n    #\n    y = pm.StudentT(\"y\", mu=mu, sigma=sigma, nu=nu, observed=data)\n    idata_t = pm.sample(1_000)","key":"D5WZZOIkRS"},{"type":"outputs","id":"_sXbESuRDbkcIl0CiHmx4","key":"KSiNAz8U1B","children":[{"type":"output","jupyter_data":{"name":"stderr","output_type":"stream","text":"Auto-assigning NUTS sampler...\nInitializing NUTS using jitter+adapt_diag...\nMultiprocess sampling (4 chains in 4 jobs)\nNUTS: [mu, sigma, nu]\n"},"children":[]},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"application/vnd.jupyter.widget-view+json":{"content":"{\"model_id\":\"0498b044cc99422790bbf5464363133c\",\"version_major\":2,\"version_minor\":0}","content_type":"application/vnd.jupyter.widget-view+json"},"text/plain":{"content":"Output()","content_type":"text/plain"}}},"children":[]},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/html":{"content":"<pre style=\"white-space:pre;overflow-x:auto;line-height:normal;font-family:Menlo,'DejaVu Sans Mono',consolas,'Courier New',monospace\"></pre>\n","content_type":"text/html"},"text/plain":{"content":"","content_type":"text/plain"}}},"children":[]},{"type":"output","jupyter_data":{"name":"stderr","output_type":"stream","text":"Sampling 4 chains for 1_000 tune and 1_000 draw iterations (4_000 + 4_000 draws total) took 2 seconds.\n"},"children":[]}]}],"key":"XGxbEqXL0M"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"az.plot_trace(idata_t)","key":"kf32jLRcdW"},{"type":"outputs","id":"0LL3aW-Y63Qxzt_uK1hvj","key":"Po1qiD3Y5R","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"b021b2f7e1646a0a162196e9ea0fa9cb","path":"/jupyter_books/msml610/build/b021b2f7e1646a0a162196e9ea0fa9cb.png"},"text/plain":{"content":"<Figure size 1200x600 with 6 Axes>","content_type":"text/plain"}}},"children":[]}]}],"key":"cAitrsLSMu"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"az.summary(idata_t, kind=\"stats\").round(2)","key":"LsWp61fZTC"},{"type":"outputs","id":"QFOaGqKKNLJd-AsqfNwf_","key":"E9WRKAdK5l","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":18,"metadata":{},"data":{"text/html":{"content":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n<