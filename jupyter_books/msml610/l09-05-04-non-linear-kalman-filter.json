e","children":[{"type":"code","lang":"python","executable":true,"value":"# Create 500,000 samples with mean 0, std 1.\ngaussian = (0.0, 1.0)\ndata = normal(loc=gaussian[0], scale=gaussian[1], size=500000)\n\ntime_ut.plot_nonlinear_func(data, f)","key":"Gwqircg3kO"},{"type":"outputs","id":"V6kP31DT8AfBQK-XWgsYQ","key":"cPRSKTkEc9","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"3cc1e7474b279c9b920991c35fd9d418","path":"/jupyter_books/msml610/build/3cc1e7474b279c9b920991c35fd9d418.png"},"text/plain":{"content":"<Figure size 800x600 with 3 Axes>","content_type":"text/plain"}}},"children":[]}]}],"key":"IbomfNPXyX"},{"type":"block","kind":"notebook-code","data":{"lines_to_next_cell":1},"children":[{"type":"code","lang":"python","executable":true,"value":"# Plot N points.\nN = 30000\nplt.subplot(121)\nplt.scatter(data[:N], range(N), alpha=0.2, s=1)\nplt.title(\"Input\")\nplt.subplot(122)\nplt.title(\"Output\")\nplt.scatter(f(data[:N]), range(N), alpha=0.2, s=1)","key":"y2gBOzkmYh"},{"type":"outputs","id":"giqyBegkdpAcqhmgm7Lh7","key":"IdpV7JG1tR","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"7ab2c0f65a9bf13dfad6fcca054a69e4","path":"/jupyter_books/msml610/build/7ab2c0f65a9bf13dfad6fcca054a69e4.png"},"text/plain":{"content":"<Figure size 800x300 with 2 Axes>","content_type":"text/plain"}}},"children":[]}]}],"key":"j37IZYYPS4"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def f_nonlinear_xy(x, y):\n    return np.array([x + y, 0.1 * x**2 + y * y])","key":"bEezosXe3G"},{"type":"outputs","id":"yraC9QH0ZWPGIpGjaBLcC","key":"d9eUA9FVt1","children":[]}],"key":"seS9efb9df"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"time_ut.plot_nonlinear_xy()","key":"Ql79spP5qL"},{"type":"outputs","id":"sW8dPoxmPG6qCYcpJVnkv","key":"JHlEogsIgV","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"17ed648aa52bf479d46f95cd14c7e389","path":"/jupyter_books/msml610/build/17ed648aa52bf479d46f95cd14c7e389.png"},"text/plain":{"content":"<Figure size 800x600 with 1 Axes>","content_type":"text/plain"}}},"children":[]}]}],"key":"U7MJIG5a2u"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Create a Gaussian.\nN = 10000\nmean = (0.0, 0.0)\np = np.array([[32.0, 15.0], [15.0, 40.0]])\nxs, ys = multivariate_normal(mean=mean, cov=p, size=N).T\n\n# Compute linearized mean.\nmean1 = f_nonlinear_xy(np.mean(xs), np.mean(ys))\n_LOG.info(\"f(mean)=%s\", mean1)\nmean2 = np.mean(\n    [f_nonlinear_xy(xs_tmp, ys_tmp) for xs_tmp, ys_tmp in zip(xs, ys)], axis=0\n)\n_LOG.info(\"mean(f)=%s\", mean2)\n# Plot both.\ntime_ut.plot_monte_carlo_mean(xs, ys, f_nonlinear_xy, mean1, \"Linearized Mean\")","key":"LnngE86aUK"},{"type":"outputs","id":"jwuHXeD70_TXbZj44d8Ww","key":"LPahtd1MIO","children":[{"type":"output","jupyter_data":{"name":"stderr","output_type":"stream","text":"INFO:__main__:f(mean)=[0.06708904 0.00185213]\nINFO:__main__:mean(f)=[ 0.06708904 43.25045478]\n"},"children":[]},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"c2ddf265026a656cfa1a76755d993c0e","path":"/jupyter_books/msml610/build/c2ddf265026a656cfa1a76755d993c0e.png"},"text/plain":{"content":"<Figure size 800x300 with 2 Axes>","content_type":"text/plain"}}},"children":[]}]}],"key":"uBSkGRkSXt"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Unscented transform","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"VLC43S7Jj5"}],"identifier":"unscented-transform","label":"Unscented transform","html_id":"unscented-transform","implicit":true,"key":"QxEtrS6y18"}],"key":"hPFkgW9QuT"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Create the sigma points for the Gaussian.\n\nfrom filterpy.kalman import MerweScaledSigmaPoints\nimport scipy.stats as stats\n\n# Initial mean and covariance.\nmean = (0.0, 0.0)\np = np.array([[32.0, 15.0], [15.0, 40.0]])\n\n# Create sigma points and weights from the initial distribution.\npoints = MerweScaledSigmaPoints(n=2, alpha=0.3, beta=2.0, kappa=0.1)\nsigmas = points.sigma_points(mean, p)\n\n# Generate random points.\nplt.figure(figsize=[4, 4])\nnp.random.seed(100)\nxs, ys = multivariate_normal(mean=mean, cov=p, size=5000).T\nplt.scatter(xs, ys, marker=\"o\", alpha=0.05, color=\"k\", edgecolors=\"none\")\nplt.scatter(sigmas[:, 0], sigmas[:, 1], c=\"r\", s=30);","key":"r1PPeEAzby"},{"type":"outputs","id":"BYibjU5ldTOTgpLNMyV35","key":"TmSw4q4UgB","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"8b6c9a74f89105e19647137fd82aecd3","path":"/jupyter_books/msml610/build/8b6c9a74f89105e19647137fd82aecd3.png"},"text/plain":{"content":"<Figure size 400x400 with 1 Axes>","content_type":"text/plain"}}},"children":[]}]}],"key":"WY6yryaaRa"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from filterpy.kalman import MerweScaledSigmaPoints, unscented_transform\nimport scipy.stats as stats\n\n# Transform sigma points through non-linear function.\nsigmas_f = np.empty((5, 2))\nfor i in range(5):\n    sigmas_f[i] = f_nonlinear_xy(sigmas[i, 0], sigmas[i, 1])\n    \n# Use unscented transform to get new mean and covariance.\nukf_mean, ukf_cov = unscented_transform(sigmas_f, points.Wm, points.Wc)\n\n# Generate random points.\nnp.random.seed(100)\nxs, ys = multivariate_normal(mean=mean, cov=p, size=5000).T\ntime_ut.plot_monte_carlo_mean(xs, ys, f_nonlinear_xy, ukf_mean, \"Unscented Mean\")","key":"HntmJml2lp"},{"type":"outputs","id":"thCN7JZIHo7QRYohV4a4q","key":"FpADntlSXL","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"1936885fd1d0398c3189d9a27a6602d4","path":"/jupyter_books/msml610/build/1936885fd1d0398c3189d9a27a6602d4.png"},"text/plain":{"content":"<Figure size 800x300 with 2 Axes>","content_type":"text/plain"}}},"children":[]}]}],"key":"urTeU7Mou0"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Using only 5 points we were able to compute the mean with great accuracy.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"brvyYwHsKz"}],"key":"ZoLLTJCh3k"}],"key":"do398jlCvO"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Compute linearized mean.\nmean1 = f_nonlinear_xy(np.mean(xs), np.mean(ys))\n_LOG.info(\"f(mean)=%s\", mean1)\n#\n_LOG.info(\"mean(f)=%s\", ukf_mean)","key":"acI6OG9Deg"},{"type":"outputs","id":"xxcVFlfCtYnByJxMSCvy7","key":"AfGlUNG4nr","children":[{"type":"output","jupyter_data":{"name":"stderr","output_type":"stream","text":"INFO:__main__:f(mean)=[-0.0965117   0.00646045]\nINFO:__main__:mean(f)=[2.00589856e-15 4.32000000e+01]\n"},"children":[]}]}],"key":"vT0xR3zVa5"}],"key":"E0VerFJv6j"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Multivariate Kalman Filter","url":"/l09-05-03-multivariate-kalman-filter","group":"L09 - Kalman Filter"},"next":{"title":"Multi-Armed Bandit Simulation Classes API","url":"/l09-03-01-multi-armed-bandits-sim-api","group":"L09 - Multi-Armed Bandits"}}},"domain":"http://localhost:3000"}