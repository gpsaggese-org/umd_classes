ckground()","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"htzKBnFeb9"},{"type":"text","value":" serves it with a real\n","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"s6DzstaYdG"},{"type":"inlineCode","value":"uvicorn","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"xa96shwijM"},{"type":"text","value":" server, on a background thread so the rest of the notebook can\nkeep running","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"AUnwXoxlKd"}],"key":"pJQcsj5MoD"},{"type":"listItem","spread":true,"position":{"start":{"line":8,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"inlineCode","value":"httpx","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"sCQUmWqj25"},{"type":"text","value":" drives the app over real HTTP, the same way a browser or another\nservice would","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"uckFD2UwO4"}],"key":"OTaydUPA6i"}],"key":"Y5fcfDdRZp"},{"type":"paragraph","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"This is the production-shaped path.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"QV4FeRtLDg"}],"key":"DoWr15sMli"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":12,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":12,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"inlineCode","value":"fastapi.API.ipynb","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"r5qV9NOBNV"},{"type":"text","value":" covers the same app’s building blocks in-process with\n","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"loOSDCnqTD"},{"type":"inlineCode","value":"TestClient","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"mm8o1No5bX"},{"type":"text","value":", which is faster for exploration but skips the network entirely.","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"vEFWq5YciA"}],"key":"MnmGRV712E"}],"key":"oQOP2noQio"},{"type":"paragraph","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"strong","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"Must run top to bottom after a kernel restart.","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"fwcx2tVJgr"}],"key":"PZDxKQ7rY1"}],"key":"cgkNyNR5EI"}],"key":"n9o9NEq7y2"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"!pip install --quiet -r tutorial_requirements.txt","key":"B2jLfbzz8N"},{"type":"outputs","id":"rrBV4mC4pqn9E45T9F0jr","key":"KjoEfOezfY","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"\u001b[33mWARNING: Running pip as the 'root' user can result in broken permissions and conflicting behaviour with the system package manager, possibly rendering your system unusable. It is recommended to use a virtual environment instead: https://pip.pypa.io/warnings/venv. Use the --root-user-action option if you know what you are doing and want to suppress this warning.\u001b[0m\u001b[33m\n\u001b[0m"},"children":[]}]}],"key":"SubyUSdUc3"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"%load_ext autoreload\n%autoreload 2\n\nimport logging\n\nimport httpx\n\nimport fastapi_utils\nimport helpers.hdbg as hdbg\nimport helpers.hintrospection as hintros\n\nhdbg.init_logger(verbosity=logging.INFO)\n_LOG = logging.getLogger(__name__)\n\nPORT = 8010\nBASE_URL = f\"http://127.0.0.1:{PORT}\"","key":"jNgK5rtdXr"},{"type":"outputs","id":"RwVEVK_X6Ji9MQXXVWVim","key":"H68Lqgg8ST","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"The autoreload extension is already loaded. To reload it, use:\n  %reload_ext autoreload\n\u001b[0m\u001b[33mWARNING\u001b[0m: Logger already initialized: skipping\n"},"children":[]}]}],"key":"KMU1aahzGb"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Part 1: Build the App","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"iiKmjqflYK"}],"identifier":"part-1-build-the-app","label":"Part 1: Build the App","html_id":"part-1-build-the-app","implicit":true,"key":"AjccxzuBCB"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"inlineCode","value":"create_book_app()","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"GYCyqhIlCf"},{"type":"text","value":" wires up the routes and seeds an in-memory catalog.\nListing ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"SRNmkRzkOs"},{"type":"inlineCode","value":"app.routes","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"uP2sQ0np8v"},{"type":"text","value":" shows exactly what got registered, which is a useful\nsanity check before starting the server.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"FefxeMWD5b"}],"key":"B7LRDaz12l"}],"key":"US4YBMaM9d"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"hintros.print_obj_info(fastapi_utils.create_book_app)","key":"EThRHrTihy"},{"type":"outputs","id":"Mi1q4wRnLDnCcPqlSxaka","key":"Z9GAaBhGFw","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/markdown":{"content":"**function**","content_type":"text/markdown"},"text/plain":{"content":"<IPython.core.display.Markdown object>","content_type":"text/plain"}}},"children":[]},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"https://github.com/gpsaggese/gpsaggese.github.io/blob/gp_scratch/tutorials/fastapi/fastapi_utils.py#L94\n"},"children":[]}]}],"key":"OHu9nwMoCm"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Build the app: wires up the routes and seeds the in-memory catalog.\napp = fastapi_utils.create_book_app()\n\nfor route in app.routes:\n    methods = \",\".join(sorted(getattr(route, \"methods\", []) or []))\n    _LOG.info(\"%-6s %s\", methods, getattr(route, \"path\", route))\n# Outcome: `app` is a ready-to-serve `FastAPI` instance; the log lists every\n# registered route, including the built-in `/docs`, `/redoc`, and\n# `/openapi.json`, plus the catalog's `/health` and `/books` routes.","key":"YwXMI4sGF8"},{"type":"outputs","id":"zJ3sKKG117q15sO6jAftV","key":"g7i9MWtRDI","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"INFO  GET,HEAD /openapi.json\nINFO  GET,HEAD /docs\nINFO  GET,HEAD /docs/oauth2-redirect\nINFO  GET,HEAD /redoc\nINFO  GET    /health\nINFO  GET    /books\nINFO  GET    /books/{book_id}\nINFO  POST   /books\nINFO  PATCH  /books/{book_id}\nINFO  DELETE /books/{book_id}\n"},"children":[]}]}],"key":"QVwVOioKbD"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Part 2: Start the Server","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"lTRSp5qLxw"}],"identifier":"part-2-start-the-server","label":"Part 2: Start the Server","html_id":"part-2-start-the-server","implicit":true,"key":"baAnniRHPS"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"inlineCode","value":"run_server_in_background()","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"C8EWhH7zb6"},{"type":"text","value":" starts ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"bGvETIt9k6"},{"type":"inlineCode","value":"uvicorn","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"WJ7Db6bc7P"},{"type":"text","value":" on a daemon thread.\n","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"UF0K8uf7E7"},{"type":"inlineCode","value":"wait_for_server()","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"oud4Mxarsf"},{"type":"text","value":" polls ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"bZCT0KVCg6"},{"type":"inlineCode","value":"/health","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"bQ9PPDHLdQ"},{"type":"text","value":" until the socket accepts connections,\nso the next cell never races the server startup.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"u0L8ysE20M"}],"key":"vRCRJRnfYG"}],"key":"OzsGfE0EhJ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Start `uvicorn` on a daemon thread, then block until `/health` responds.\nserver, server_thread = fastapi_utils.run_server_in_background(app, port=PORT)\nfastapi_utils.wait_for_server(f\"{BASE_URL}/health\")\n_LOG.info(\"Server is up at %s\", BASE_URL)\n# Outcome: the server is accepting real TCP connections at `BASE_URL`.","key":"Uax1Avxjb1"},{"type":"outputs","id":"IY8LlEzR99lfLgRe2BpNn","key":"joCsGQ6p7G","children":[]}],"key":"xizhQqG1hw"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Part 3: List and Filter Books","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"e0RocjJ855"}],"identifier":"part-3-list-and-filter-books","label":"Part 3: List and Filter Books","html_id":"part-3-list-and-filter-books","implicit":true,"key":"jbn6xrfZED"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"These are real HTTP requests: ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"BxTYPHOwze"},{"type":"inlineCode","value":"httpx","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"K4oKP45qoT"},{"type":"text","value":" opens a TCP connection to\n","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"XfueZl1R3c"},{"type":"inlineCode","value":"127.0.0.1:8010","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"PbEoAG0mFJ"},{"type":"text","value":" instead of calling the app object directly.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"zlcOZLQAwP"}],"key":"CHxAZkE8k4"}],"key":"RNX5dziKdj"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# List every book in the catalog.\nresponse = httpx.get(f\"{BASE_URL}/books\")\nresponse.raise_for_status()\n_LOG.info(\"All books: %s\", [book[\"title\"] for book in response.json()])\n# Outcome: all 3 seeded books, in insertion order.\n\n# Filter to only out-of-stock books via the `in_stock` query parameter.\nresponse = httpx.get(f\"{BASE_URL}/books\", params={\"in_stock\": False})\n_LOG.info(\"Out-of-stock books: %s\", [book[\"title\"] for book in response.json()])\n# Outcome: just \"Designing Data-Intensive Applications\", the only seed book\n# marked out of stock.\n\n# Cap the result to one book via the `limit` query parameter.\nresponse = httpx.get(f\"{BASE_URL}/books\", params={\"limit\": 1})\n_LOG.info(\"First book only: %s\", [book[\"title\"] for book in response.json()])\n# Outcome: only \"Fluent Python\", the first seeded book.","key":"S4HnANShFe"},{"type":"outputs","id":"MhfIdRrJ6KFT_SIEZNmJC","key":"Ee3vCRJ8jf","children":[]}],"key":"KByg0nOatq"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Part 4: Create, Update, and Delete a Book","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"eEzJLNiOIi"}],"identifier":"part-4-create-update-and-delete-a-book","label":"Part 4: Create, Update, and Delete a Book","html_id":"part-4-create-update-and-delete-a-book","implicit":true,"key":"V1qHcWuTAK"}],"key":"YzLxk7mtW8"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Create a new book; the server assigns the `id`.\nresponse = httpx.post(\n    f\"{BASE_URL}/books\",\n    json={\"title\": \"The Pragmatic Programmer\", \"author\": \"Hunt & Thomas\", \"year\": 1999},\n)\nresponse.raise_for_status()\nnew_book = response.json()\n_LOG.info(\"Created book %s: %s\", new_book[\"id\"], new_book[\"title\"])\n# Outcome: 201 Created; `new_book[\"id\"]` is 4, the next free ID after the\n# 3 seeded books.","key":"gpbj99PHbv"},{"type":"outputs","id":"wcXJQZKBVbXD-lq59BC-Z","key":"ZvWjGGa7fe","children":[]}],"key":"k7eksBPgwf"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Replace the new book's fields, flipping it to out of stock.\nresponse = httpx.patch(\n    f\"{BASE_URL}/books/{new_book['id']}\",\n    json={\n        \"title\": new_book[\"title\"],\n        \"author\": new_book[\"author\"],\n        \"year\": new_book[\"year\"],\n        \"in_stock\": False,\n    },\n)\nresponse.raise_for_status()\n_LOG.info(\"Updated book: %s\", response.json())\n# Outcome: 200 OK; the same book is returned with `in_stock` now `False`.","key":"RE4mAL4kRR"},{"type":"outputs","id":"d99GDOBSpPXLelDTT-VqF","key":"XxaRq4bzoN","children":[]}],"key":"zTjiFS0rI5"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Delete the book that was just created and updated.\nresponse = httpx.delete(f\"{BASE_URL}/books/{new_book['id']}\")\n_LOG.info(\"DELETE status: %s\", response.status_code)\n# Outcome: 204 No Content; the book is removed from the catalog.\n\n# Confirm the deletion: the same ID should no longer resolve.\nresponse = httpx.get(f\"{BASE_URL}/books/{new_book['id']}\")\n_LOG.info(\"GET after delete: %s\", response.status_code)\n# Outcome: 404 Not Found.","key":"TelK3Qq2aL"},{"type":"outputs","id":"5p51R7uNYLepLilcDmY-k","key":"vcuYbpoU5D","children":[]}],"key":"ULGbtKj7sQ"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Part 5: Handle Errors","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"GSD9tcp64q"}],"identifier":"part-5-handle-errors","label":"Part 5: Handle Errors","html_id":"part-5-handle-errors","implicit":true,"key":"dfTAyX9Aqt"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"A missing book returns ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"SH6Gf3OyE6"},{"type":"inlineCode","value":"404","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"pbuZeRyNn3"},{"type":"text","value":"; an invalid payload never reaches the handler\nand returns ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"rJwmq2BeFi"},{"type":"inlineCode","value":"422","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"GVwQ32vXx5"},{"type":"text","value":" with a description of what failed.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"hiqr8I8FyN"}],"key":"xLwdy6njzr"}],"key":"DtcpFQZPjt"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Look up a book ID that was never created.\nresponse = httpx.get(f\"{BASE_URL}/books/99999\")\n_LOG.info(\"GET missing book -> %s %s\", response.status_code, response.json())\n# Outcome: 404 Not Found with {\"detail\": \"Book 99999 not found\"}.\n\n# Send a payload missing the required `author` and `year` fields.\nresponse = httpx.post(f\"{BASE_URL}/books\", json={\"title\": \"No Author or Year\"})\n_LOG.info(\"POST invalid payload -> %s\", response.status_code)\nfor error in response.json()[\"detail\"]:\n    _LOG.info(\"  %s: %s\", error[\"loc\"], error[\"msg\"])\n# Outcome: 422 Unprocessable Entity; the handler never runs, and the\n# response lists both missing fields.","key":"izibv3RGop"},{"type":"outputs","id":"O9PPjwWnz3XUw2H4ikvLL","key":"SZgZvBiSlD","children":[]}],"key":"eytZ49p81v"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Part 6: Inspect the Live Docs","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"gJ0dsoU3RX"}],"identifier":"part-6-inspect-the-live-docs","label":"Part 6: Inspect the Live Docs","html_id":"part-6-inspect-the-live-docs","implicit":true,"key":"LqYwSDUnkB"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"With the server running, ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"kOogGNnvwz"},{"type":"inlineCode","value":"/openapi.json","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"DMPfmssHPa"},{"type":"text","value":" is reachable over HTTP, and so are\nthe human-facing ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"QPLh3cnpv6"},{"type":"inlineCode","value":"/docs","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"oGMFqXW1Hy"},{"type":"text","value":" (Swagger UI) and ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ufMtLqdCPs"},{"type":"inlineCode","value":"/redoc","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"viP8w0WJUq"},{"type":"text","value":" pages. Point a browser at\n","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"rDl8Yn0aMF"},{"type":"inlineCode","value":"http://127.0.0.1:8010/docs","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"YsFxaYBQeV"},{"type":"text","value":" while this notebook’s server is up to try it\ninteractively.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"cw3GFSMs5s"}],"key":"LZFZFjuep7"}],"key":"GmhDrlsBdk"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Fetch the OpenAPI schema `FastAPI` generated automatically.\nresponse = httpx.get(f\"{BASE_URL}/openapi.json\")\nschema = response.json()\n_LOG.info(\"OpenAPI title: %s\", schema[\"info\"][\"title\"])\n_LOG.info(\"Registered paths: %s\", sorted(schema[\"paths\"].keys()))\n# Outcome: title \"Book Catalog API\"; paths are /books, /books/{book_id},\n# and /health.","key":"EpLpNtXiQp"},{"type":"outputs","id":"p5LDWWro4q95UOUx7jRxM","key":"wWx9Ed9ZMy","children":[]}],"key":"vSQnZgMq6V"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Part 7: Shut Down the Server","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"gGmt2Oy6hY"}],"identifier":"part-7-shut-down-the-server","label":"Part 7: Shut Down the Server","html_id":"part-7-shut-down-the-server","implicit":true,"key":"gsZDs03L9f"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"Always stop the background server before the kernel exits, so the port is\nfreed for the next run.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"aqpW218Vvp"}],"key":"G3OT3bBIRj"}],"key":"JQ8VfyV9RG"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Stop the background `uvicorn` server and join its thread.\nfastapi_utils.stop_server(server, server_thread)\n_LOG.info(\"Server thread alive: %s\", server_thread.is_alive())\n# Outcome: `False`; the server thread has exited and the port is freed.","key":"ocLv5L4pxW"},{"type":"outputs","id":"uJnm2_AoLwtahEFWO81FT","key":"onRiXG7R4q","children":[]}],"key":"E7SxJC2U21"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Wrap-up","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"tc1958fLUT"}],"identifier":"wrap-up","label":"Wrap-up","html_id":"wrap-up","implicit":true,"key":"iH0HecEeCn"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"This notebook covered the full lifecycle of a ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"zhrNZesN8u"},{"type":"inlineCode","value":"FastAPI","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Lq6cpeIEhX"},{"type":"text","value":" service: build the\napp, serve it with ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"SuqMbUxBoA"},{"type":"inlineCode","value":"uvicorn","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Oh2BVYrzSA"},{"type":"text","value":", call it over real HTTP, and shut it down\ncleanly. See ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"DnFUtQ04YB"},{"type":"inlineCode","value":"README.md","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"sdOQiKeLqg"},{"type":"text","value":" for how to run the same app from the command line\nwith ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"W8cwqWjwn8"},{"type":"inlineCode","value":"uvicorn fastapi_utils:app --reload","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"GixBQYq6J3"},{"type":"text","value":" instead of from a notebook.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ub6Yxrmy82"}],"key":"uGe9NgUyLJ"}],"key":"rrLxvOnruP"}],"key":"dJeVAuuHUc"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"FastAPI API Overview","url":"/fastapi-api","group":"data science packages"},"next":{"title":"gCastle Tutorial","url":"/readme-20","group":"data science packages"}}},"domain":"http://localhost:3000"}