column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Part 1: Generate Economic Data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"RIWG9aY4Jo"}],"identifier":"part-1-generate-economic-data","label":"Part 1: Generate Economic Data","html_id":"part-1-generate-economic-data","implicit":true,"key":"swNqcXVlf8"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"We’ll simulate a realistic economic system where variables have\ncausal relationships, then discover these relationships.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"HRrlx4zdSO"}],"key":"NL0AQN6OjT"}],"key":"vnsTaZgCl4"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Generate synthetic economic data.\n# Variables: GDP, Inflation, Unemployment, Interest_Rate, Stock_Market\nn_nodes = 5\nn_samples = 1000\nnode_names = [\n    \"GDP\",\n    \"Inflation\",\n    \"Unemployment\",\n    \"Interest_Rate\",\n    \"Stock_Market\",\n]\n\nprint(\n    f\"Generating {n_nodes}-variable economic system with {n_samples} observations...\"\n)\n\ndata, true_dag = tgcasti.generate_synthetic_data(\n    n_nodes=n_nodes,\n    n_edges=6,\n    n_samples=n_samples,\n    seed=123,\n)\n\n# Rename columns to meaningful names.\ndata.columns = node_names\n\nprint(f\"\\nGenerated data shape: {data.shape}\")\nprint(\"\\nData summary statistics:\")\nprint(data.describe())","key":"hUVCQ30VJL"},{"type":"outputs","id":"F72xvwo9i-NkX83SLmPO8","key":"yt8RXaInhh","children":[]}],"key":"hOACCaIpfd"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Part 2: Visualize the True Causal Structure","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"TlYM7tBfzz"}],"identifier":"part-2-visualize-the-true-causal-structure","label":"Part 2: Visualize the True Causal Structure","html_id":"part-2-visualize-the-true-causal-structure","implicit":true,"key":"F7MGFWElvo"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Before running discovery algorithms, let’s see what the ground truth DAG looks like.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"UELzonSvK8"}],"key":"RMwMQnLCix"}],"key":"vuQnKbdXzo"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Visualize true causal relationships.\nfig = tgcasti.visualize_dag(\n    true_dag.to_numpy(),\n    title=\"True Economic Causal Structure\",\n    node_labels=node_names,\n    figsize=(10, 8),\n)\nprint(\"This is the true causal structure we're trying to discover.\")","key":"zCYhLdNqE3"},{"type":"outputs","id":"Gtgq6xFujEiKsKJ91tHO7","key":"sCMDAPx3t1","children":[]}],"key":"P7MddoAaE8"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Part 3: Run Multiple Discovery Algorithms","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"pivMSzbYx0"}],"identifier":"part-3-run-multiple-discovery-algorithms","label":"Part 3: Run Multiple Discovery Algorithms","html_id":"part-3-run-multiple-discovery-algorithms","implicit":true,"key":"SE2HtLozi0"}],"key":"grTVEE3cFZ"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Constraint-Based Approach (PC)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Khe6dBYq7J"}],"identifier":"constraint-based-approach-pc","label":"Constraint-Based Approach (PC)","html_id":"constraint-based-approach-pc","implicit":true,"key":"alt2uL0K4C"}],"key":"SPV06GB3BH"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# The PC algorithm uses statistical independence tests.\n# It's robust but requires sufficient data.\n\n_LOG.info(\"Running PC algorithm...\")\npc_result = tgcasti.run_pc_algorithm(\n    data.values,\n    alpha=0.05,\n)\n\npc_metrics = tgcasti.evaluate_causal_discovery(\n    true_dag.to_numpy(),\n    pc_result,\n)\n\nprint(\"PC Algorithm Results:\")\nprint(f\"  F1 Score: {pc_metrics['F1']:.4f}\")\nprint(f\"  Structural Hamming Distance: {pc_metrics['SHD']:.1f}\")\nprint(f\"  False Discovery Rate: {pc_metrics['FDR']:.4f}\")\nprint(f\"  True Positive Rate: {pc_metrics['TPR']:.4f}\")","key":"z91CCUGNZm"},{"type":"outputs","id":"7lu3InNbXalCWntIVPxWr","key":"WMnokRzdu0","children":[]}],"key":"okgez3Uj9N"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Score-Based Approach (GES)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"B7K4JvcwpB"}],"identifier":"score-based-approach-ges","label":"Score-Based Approach (GES)","html_id":"score-based-approach-ges","implicit":true,"key":"VBkADhyyLH"}],"key":"D3zw5V7kIL"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# GES optimizes a Bayesian score function.\n# It's efficient and works well with moderate-sized datasets.\n\n_LOG.info(\"Running GES algorithm...\")\nges_result = tgcasti.run_ges_algorithm(data.values)\n\nges_metrics = tgcasti.evaluate_causal_discovery(\n    true_dag.to_numpy(),\n    ges_result,\n)\n\nprint(\"GES Algorithm Results:\")\nprint(f\"  F1 Score: {ges_metrics['F1']:.4f}\")\nprint(f\"  Structural Hamming Distance: {ges_metrics['SHD']:.1f}\")\nprint(f\"  False Discovery Rate: {ges_metrics['FDR']:.4f}\")\nprint(f\"  True Positive Rate: {ges_metrics['TPR']:.4f}\")","key":"vGpIQFfe9m"},{"type":"outputs","id":"_Z38g6HFWNMv-P6Kemlns","key":"hvc8XPldjC","children":[]}],"key":"jNhscTjTe3"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Gradient-Based Approach (NOTEARS)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"qnF6qVQ85l"}],"identifier":"gradient-based-approach-notears","label":"Gradient-Based Approach (NOTEARS)","html_id":"gradient-based-approach-notears","implicit":true,"key":"cECWjE7TON"}],"key":"ynJ4S6Kpl3"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# NOTEARS uses continuous optimization with acyclicity constraints.\n# It's scalable and handles large datasets efficiently.\n\n_LOG.info(\"Running NOTEARS algorithm...\")\nnotears_result = tgcasti.run_notears_algorithm(\n    data.values,\n    lambda1=0.01,\n    loss_type=\"l2\",\n)\n\nnotears_metrics = tgcasti.evaluate_causal_discovery(\n    true_dag.to_numpy(),\n    notears_result,\n)\n\nprint(\"NOTEARS Algorithm Results:\")\nprint(f\"  F1 Score: {notears_metrics['F1']:.4f}\")\nprint(f\"  Structural Hamming Distance: {notears_metrics['SHD']:.1f}\")\nprint(f\"  False Discovery Rate: {notears_metrics['FDR']:.4f}\")\nprint(f\"  True Positive Rate: {notears_metrics['TPR']:.4f}\")","key":"jMScDmt2bi"},{"type":"outputs","id":"uGjJizjGZXQF7qDtzr-cu","key":"MepIP6MMwo","children":[]}],"key":"YBsJkbiDTs"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Part 4: Thresholding Weighted Results","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"djlzJ8ke6j"}],"identifier":"part-4-thresholding-weighted-results","label":"Part 4: Thresholding Weighted Results","html_id":"part-4-thresholding-weighted-results","implicit":true,"key":"WTeO39byIx"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Some algorithms return weighted edges. Apply a threshold to binarize them.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Zdb98JqoPg"}],"key":"xUw2woApyr"}],"key":"NTW5tIReOj"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Threshold the NOTEARS result (remove weak edges).\nnotears_binary = tgcasti.thresholded_dag(\n    notears_result,\n    threshold=0.2,\n)\n\nnotears_binary_metrics = tgcasti.evaluate_causal_discovery(\n    true_dag.to_numpy(),\n    notears_binary,\n)\n\nprint(\"NOTEARS (thresholded at 0.2):\")\nprint(f\"  F1 Score: {notears_binary_metrics['F1']:.4f}\")\nprint(f\"  Structural Hamming Distance: {notears_binary_metrics['SHD']:.1f}\")","key":"Qqk86Yojd1"},{"type":"outputs","id":"6EuCVdIfoFneTvoj5-cHX","key":"KbAs6yywLK","children":[]}],"key":"BzjdgMSGNo"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Part 5: Comprehensive Comparison","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"qgddvUEHTR"}],"identifier":"part-5-comprehensive-comparison","label":"Part 5: Comprehensive Comparison","html_id":"part-5-comprehensive-comparison","implicit":true,"key":"LEKvkEUmaO"}],"key":"s5Fl9EKLWr"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Compare all discovered structures side-by-side.\nalgorithms_results = {\n    \"PC\": pc_result,\n    \"GES\": ges_result,\n    \"NOTEARS\": notears_result,\n}\n\nfig = tgcasti.compare_dags(\n    true_dag.to_numpy(),\n    algorithms_results,\n    node_labels=node_names,\n)\nfig.suptitle(\n    \"Causal Discovery Results: Economic Indicators\",\n    fontsize=14,\n    fontweight=\"bold\",\n)","key":"F0CNU8vVnW"},{"type":"outputs","id":"ceVaZ7xw3LPlh_DZgGnTA","key":"dHE1BExOBc","children":[]}],"key":"edN2koFGiW"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Part 6: Performance Summary","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"JTOvD4TK50"}],"identifier":"part-6-performance-summary","label":"Part 6: Performance Summary","html_id":"part-6-performance-summary","implicit":true,"key":"h6SLwCshF9"}],"key":"SDrqGR73dY"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Create a comprehensive performance comparison.\ncomparison_data = {\n    \"Algorithm\": [\"PC\", \"GES\", \"NOTEARS\", \"NOTEARS*\"],\n    \"F1\": [\n        pc_metrics[\"F1\"],\n        ges_metrics[\"F1\"],\n        notears_metrics[\"F1\"],\n        notears_binary_metrics[\"F1\"],\n    ],\n    \"SHD\": [\n        pc_metrics[\"SHD\"],\n        ges_metrics[\"SHD\"],\n        notears_metrics[\"SHD\"],\n        notears_binary_metrics[\"SHD\"],\n    ],\n    \"TPR\": [\n        pc_metrics[\"TPR\"],\n        ges_metrics[\"TPR\"],\n        notears_metrics[\"TPR\"],\n        notears_binary_metrics[\"TPR\"],\n    ],\n    \"FDR\": [\n        pc_metrics[\"FDR\"],\n        ges_metrics[\"FDR\"],\n        notears_metrics[\"FDR\"],\n        notears_binary_metrics[\"FDR\"],\n    ],\n}\n\ncomparison_df = pd.DataFrame(comparison_data)\nprint(\"\\nPerformance Comparison Table\")\nprint(\"(* = NOTEARS with thresholding)\")\nprint(comparison_df.to_string(index=False))","key":"O9v7wVtedA"},{"type":"outputs","id":"qsefD7AaHNPatOsgGTWQV","key":"f1qt3ozsAK","children":[]}],"key":"uAPNUssmxG"},{"type":"block","kind":"notebook-content","children":[{"type":"hea