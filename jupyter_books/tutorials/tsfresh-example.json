ation","implicit":true,"key":"IWLebHFINd"},{"type":"heading","depth":3,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"One-vs-Rest ROC Curves","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"r8Ytjw1ZOh"}],"identifier":"one-vs-rest-roc-curves","label":"One-vs-Rest ROC Curves","html_id":"one-vs-rest-roc-curves","implicit":true,"key":"b9p76Dj3Qn"}],"key":"vemNDEomO4"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"n_classes = len(le.classes_)\ny_test_bin = label_binarize(y_test_enc, classes=np.arange(n_classes))\n\nplt.figure(figsize=(8, 6))\nfor k, cls in enumerate(le.classes_):\n    fpr, tpr, _ = metrics.roc_curve(y_test_bin[:, k], proba[:, k])\n    auc = metrics.auc(fpr, tpr)\n    plt.plot(fpr, tpr, label=f\"Class {cls} (AUC={auc:.3f})\")\nplt.plot([0, 1], [0, 1], \"k--\")\nplt.xlabel(\"False Positive Rate\")\nplt.ylabel(\"True Positive Rate\")\nplt.title(\"One-vs-Rest ROC Curves — HAR (RandomForest + tsfresh)\")\nplt.legend(loc=\"lower right\")\nplt.tight_layout()\nplt.show()","key":"wfbLNtykTg"},{"type":"outputs","id":"zeigp1dB-SW3klfiTqjFf","key":"EljkdjMtGz","children":[]}],"key":"pBffVTU3oa"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Top Feature Importances","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ii2WLAxHP5"}],"identifier":"top-feature-importances","label":"Top Feature Importances","html_id":"top-feature-importances","implicit":true,"key":"EAm7fmQBZn"}],"key":"w96vXGl2Fk"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"importances = pd.Series(\n    clf.feature_importances_, index=X_sel_train.columns\n).sort_values(ascending=False)\n\ntopk = 25\nplt.figure(figsize=(8, 5))\nax = importances.iloc[:topk].sort_values().plot(kind=\"barh\")\nax.set_title(f\"Top {topk} tsfresh Feature Importances\")\nax.set_xlabel(\"Importance\")\nplt.tight_layout()\nplt.show()","key":"pSMrVWNeb9"},{"type":"outputs","id":"e-9sX_HcrkU_BjNtOla6o","key":"mZ470WpKms","children":[]}],"key":"MbePqUyi28"}],"key":"aDXQEyQHgx"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"tsfresh API Overview","url":"/tsfresh-api","group":"data science packages"},"next":{"title":"tsfresh Example","url":"/tsfresh-example-1","group":"data science packages"}}},"domain":"http://localhost:3000"}