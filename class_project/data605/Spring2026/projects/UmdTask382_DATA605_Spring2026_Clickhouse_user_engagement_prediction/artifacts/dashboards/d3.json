          "editorType": "sql",
          "format": 1,
          "meta": {
            "builderOptions": {
              "columns": [],
              "database": "",
              "limit": 1000,
              "mode": "list",
              "queryType": "table",
              "table": ""
            }
          },
          "pluginVersion": "4.17.0",
          "queryType": "table",
          "rawSql": "WITH joined AS\n(\n    SELECT\n        p.model_name,\n        p.p_purchase,\n        t.has_purchase_in_session\n    FROM session_purchase_predictions AS p\n    INNER JOIN training_sessions_n5 AS t\n        ON p.user_session = t.user_session\n),\nscored AS\n(\n    SELECT\n        model_name,\n        p_purchase,\n        has_purchase_in_session,\n        arrayJoin([\n            0.05, 0.10, 0.15, 0.20, 0.25,\n            0.30, 0.35, 0.40, 0.45, 0.50,\n            0.55, 0.60, 0.65, 0.70, 0.75,\n            0.80, 0.85, 0.90, 0.95\n        ]) AS threshold\n    FROM joined\n),\nmetrics AS\n(\n    SELECT\n        model_name,\n        threshold,\n        sum(if(p_purchase >= threshold AND has_purchase_in_session = 1, 1, 0)) AS tp,\n        sum(if(p_purchase >= threshold AND has_purchase_in_session = 0, 1, 0)) AS fp,\n        sum(if(p_purchase < threshold AND has_purchase_in_session = 1, 1, 0)) AS fn,\n        tp / nullIf(tp + fp, 0) AS precision,\n        tp / nullIf(tp + fn, 0) AS recall\n    FROM scored\n    GROUP BY model_name, threshold\n)\nSELECT\n    threshold,\n\n    maxIf(recall, model_name = 'logreg') AS logreg_recall,\n    maxIf(precision, model_name = 'logreg') AS logreg_precision,\n\n    maxIf(recall, model_name = 'xgboost') AS xgboost_recall,\n    maxIf(precision, model_name = 'xgboost') AS xgboost_precision\n\nFROM metrics\nGROUP BY threshold\nORDER BY threshold;",
          "refId": "A"
        }
      ],
      "title": "Precision–Recall Curve",
      "type": "xychart"
    }
  ],
