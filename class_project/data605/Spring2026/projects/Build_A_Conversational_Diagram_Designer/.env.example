# CDD Project Environment Variables
# Copy this file to .env and fill in your keys. NEVER commit .env to git.

# Default provider — Gemini (free tier with multimodal in one model)
CDD_LLM_PROVIDER=gemini

# Gemini (primary). Get a free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here
CDD_GEMINI_MODEL=gemini-2.5-flash

# OpenAI (optional fallback)
OPENAI_API_KEY=
CDD_OPENAI_MODEL=gpt-4o-mini

# Anthropic (optional fallback)
ANTHROPIC_API_KEY=
CDD_ANTHROPIC_MODEL=claude-sonnet-4-20250514
