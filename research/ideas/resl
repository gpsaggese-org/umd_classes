#!/bin/bash -e
# """
# List available research ideas in the research/ideas/ directory.
#
# This script helps discover and filter available research ideas.
#
# Examples:
#   resl                     # List all ideas
#   resl ml                  # List ideas matching "ml"
#   resl -f                  # List all ideas with full paths
#   resl -f neural           # List neural ideas with full paths
# """

show_help() {
    grep '^# ' "$0" | sed 's/^# //' | sed '1d'
}

# Find the script directory.
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
ideas_dir="$SCRIPT_DIR"

full_path=false
pattern=""

# Parse arguments.
while [[ $# -gt 0 ]]; do
    case "$1" in
        -f)
            full_path=true
            shift
            ;;
        -h|--help)
            show_help
            exit 0
            ;;
        *)
            pattern="$1"
            shift
            ;;
    esac
done

if [[ ! -d "$ideas_dir" ]]; then
    echo "Error: $ideas_dir directory not found" >&2
    exit 1
fi

if [[ "$full_path" == true ]]; then
    # List with full paths.
    if [[ -n "$pattern" ]]; then
        find "$ideas_dir" -maxdepth 1 -type d | grep "$pattern" | sort
    else
        find "$ideas_dir" -maxdepth 1 -type d -not -name "ideas" | sort
    fi
else
    # List with relative names only.
    if [[ -n "$pattern" ]]; then
        ls -1 "$ideas_dir" | grep "$pattern"
    else
        ls -1 "$ideas_dir"
    fi
fi
