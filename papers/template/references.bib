# BibTeX entries cited from paper.md as `[@key]` (parenthetical) or
# `@key` (in-text). Citation keys use `<lastname><year><shorttopic>`, e.g.
# `walker2001minimax`.
#
# One example per common entry type is given below, commented out. Delete
# the ones you don't need and add real entries above this comment block.

# @article{lastname2024topic,
#   author  = {Lastname, Firstname and Lastname2, Firstname2},
#   title   = {Title of the Article},
#   journal = {Journal Name},
#   year    = {2024},
#   volume  = {1},
#   number  = {1},
#   pages   = {1--10},
#   doi     = {10.0000/xxxxx}
# }
#
# @inproceedings{lastname2024conf,
#   author    = {Lastname, Firstname},
#   title     = {Title of the Paper},
#   booktitle = {Proceedings of the Conference Name (ACRONYM)},
#   year      = {2024},
#   pages     = {1--8},
#   doi       = {10.0000/xxxxx}
# }
#
# @techreport{org2024report,
#   author      = {{Organization Name}},
#   title       = {Title of the Report},
#   institution = {Organization Name},
#   year        = {2024}
# }
#
# @misc{lastname2024preprint,
#   author     = {Lastname, Firstname},
#   title      = {Title of the Preprint},
#   year       = {2024},
#   eprint     = {0000.00000},
#   eprinttype = {arxiv}
# }
