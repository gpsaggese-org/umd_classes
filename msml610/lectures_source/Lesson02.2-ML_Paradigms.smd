  headers: ("Component made perfect", "Accuracy", "Gain"),
  rows: (
    ("(baseline system)", "72%", "--"),
    ("Text detection", "89%", "+17%"),
    ("+ Char. segmentation", "90%", "+1%"),
    ("+ Char. classification", "100%", "+10%"),
  ),
  caption: "Ceiling analysis on the OCR pipeline",
)
```

